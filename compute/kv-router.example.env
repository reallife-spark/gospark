# Environment for the reference KV-cache (RadixAttention) router. Copy to
# kv-router.env (gitignored) and source it, or hand these to systemd.
#
# The shared secret MUST match the node's `kv.secret` in its config. Never
# commit a real secret.

# Shared secret goSpark sends as X-Sparknet-Auth. Empty disables the check
# (loopback only).
SPARKNET_SHARED_SECRET=

# Where to bind. Loopback is safest; the Go control plane connects from the same
# host.
KV_LISTEN_HOST=127.0.0.1
KV_LISTEN_PORT=9100
KV_WORKERS=1

# Only the first N tokens of a prompt form a prefix key.
KV_MAX_PREFIX_TOKENS=64
