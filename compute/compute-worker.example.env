# Environment for the reference compute-plane worker. Copy to
# compute-worker.env (gitignored) and source it, or hand these to systemd.
#
# The shared secret MUST match the node's `compute.secret` in its agent config.
# Never commit a real secret.

# Shared secret the Go node sends as X-Sparknet-Auth. Empty disables the check
# (loopback only).
SPARKNET_SHARED_SECRET=

# Where to bind. Loopback is safest; the Go agent connects from the same host.
COMPUTE_LISTEN_HOST=127.0.0.1
COMPUTE_LISTEN_PORT=9090
COMPUTE_WORKERS=1

# Operations this worker will run. Must be mirrored in the node's
# compute.operations list. Closed set: anything else is refused.
COMPUTE_OPERATIONS=infer,embed

# Local vLLM engine. If it is unreachable, `infer` returns a deterministic
# stub unless SPARKNET_REQUIRE_VLLM=1.
VLLM_ENDPOINT=http://127.0.0.1:8000/v1/chat/completions
VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct
SPARKNET_REQUIRE_VLLM=0
